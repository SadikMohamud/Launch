{
  "name": "launch-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "cli": "npm run --workspace @snurm/launch",
    "test": "npm run test --workspace @snurm/launch",
    "test:e2e": "npm run test:e2e --workspace @snurm/launch",
    "lint": "npm run lint --workspaces --if-present",
    "site:dev": "npm run dev --workspace launch-site",
    "site:build": "npm run build --workspace launch-site"
  }
}

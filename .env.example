# Waitlist storage and email.
#
# Copy to .env.local for local development, and set the same names in the
# Vercel project settings for deployment. Never commit real values: .env
# and .env.* are gitignored, and only this example file is tracked.

# Upstash Redis, REST access. Required: without it the waitlist endpoint
# returns 503 rather than pretending a submission was stored.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend, for the confirmation email. Optional: entries are still stored
# without it, they simply receive no confirmation.
RESEND_API_KEY=
WAITLIST_FROM="Launch <hello@launch.snurm.com>"
